# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# The password everyone in the group shares.
SITE_PASSWORD=tadoba2026

# Mayuri's password. Unlocks /admin on top of everything a guest can do.
ADMIN_PASSWORD=change-this-to-something-only-mayuri-knows

# Any long random string. Signs the login cookie — change it and everyone
# simply has to log in again.
SESSION_SECRET=paste-a-long-random-string-here

# Postgres connection string. Leave it unset locally to use .data/db.json
# instead. Vercel's Neon integration sets DATABASE_URL for you automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
